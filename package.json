{
  "name": "stubsmith",
  "version": "0.2.0",
  "description": "Stubsmith Node.js SDK - instrument outbound HTTP calls, mask in-process, replay as test fixtures",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stubsmith": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "testing",
    "http",
    "mocking",
    "fixtures",
    "replay",
    "vcr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stubsmith/stubsmith-node.git"
  },
  "homepage": "https://stubsmith.dev",
  "bugs": {
    "url": "https://github.com/Stubsmith/stubsmith-node/issues"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/superagent": "^8.1.11",
    "axios": "^1.20.0",
    "eslint": "^9",
    "got": "^13.0.0",
    "node-fetch": "^3.3.2",
    "superagent": "^10.4.1",
    "tsup": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5"
  }
}
